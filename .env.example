# Host path to the Obsidian vault, bind-mounted at /vault in the container.
MARKWEAVE_VAULT_HOST=/Users/seoyeongki/Dropbox/personal/backup/메모/obsidian/dropbox

# The dedicated Docker network MarkWeave shares with Kiro Crew, and nothing else.
# MarkWeave has no authentication, so reachability is the access control: putting it
# on a shared network (npm-proxy) would give every container there read and write
# access to the vault. Create it once — both stacks are separate compose projects:
#     docker network create markweave-net
MARKWEAVE_NETWORK=markweave-net

# Optional limits (defaults shown).
# MARKWEAVE_MAX_RESULTS=20
# MARKWEAVE_MAX_SNIPPET=200
# MARKWEAVE_MAX_RESPONSE_BYTES=64000
# MARKWEAVE_MAX_FILE_BYTES=2097152
# MARKWEAVE_GRAPH_TIMEOUT=30
# MARKWEAVE_STALE_AFTER_HOURS=24
